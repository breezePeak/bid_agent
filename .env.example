OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
# API format: openai | anthropic
OPENAI_PROVIDER=openai
OPENAI_TIMEOUT=300
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_INITIAL_DELAY=2
OPENAI_RETRY_MAX_DELAY=30
OPENAI_STREAM=false
OPENAI_VERIFY_SSL=true
BID_AGENT_STAGE_STALL_TIMEOUT=900

# Web authentication. Required; use a long unique password.
BID_AGENT_AUTH_USER=admin
BID_AGENT_AUTH_PASSWORD=replace-with-a-long-random-password
# Set true only when the Web console is served over HTTPS.
BID_AGENT_AUTH_SECURE_COOKIE=false

# 单个投标/公司/模板源文件的最大上传大小（MB，范围 1-2048）。
BID_AGENT_SOURCE_UPLOAD_MAX_MB=512

# Concurrency (PR-A0). Single source of truth — no hard-coded workers in modules.
# Default chapter worker pool size (clamped to [1, BID_AGENT_WORKERS_MAX])
BID_AGENT_WORKERS_DEFAULT=4
# Hard upper bound for any API/CLI workers argument
BID_AGENT_WORKERS_MAX=10
# Process-wide concurrent LLM HTTP calls (shared across workspaces)
BID_AGENT_LLM_CONCURRENCY=8
# Writing: auto re-batch failed chapters this many times (no fire-desk handoff)
BID_AGENT_WRITE_BATCH_RETRIES=5

# Agent layer (PR-A3+). Supervisor is the default product entry.
# Set false only for emergency rollback to legacy orchestrator.
AGENT_SUPERVISOR_ENABLED=true
AGENT_USE_TOOL_RUNTIME=true
AGENT_MAX_STEPS=12
AGENT_MAX_LLM_CALLS=20
AGENT_MAX_SAME_TOOL_STREAK=2
AGENT_MAX_NO_PROGRESS_STEPS=2
AGENT_MAX_REPAIR_ROUNDS=2
AGENT_MAX_CHAPTERS_PER_INVOKE=5
AGENT_OBSERVATION_MAX_CHARS=2000
AGENT_SNAPSHOT_MAX_CHARS=12000
AGENT_DETERMINISTIC_AUTORUN=true

# 全文审核质量门禁：1=有问题则阻断后续阶段；0=仅记录不阻断
GLOBAL_REVIEW_GATE=1

# quality issues gate: strict=block stops pipeline; soft=record only
QUALITY_GATE_MODE=strict
# 章节审核门禁：1=未通过则阻断后续；0=不阻断
CHAPTER_REVIEW_GATE=1

# G4/PR-12 quality-issue enhancements
# 1=allow accept-risk for block issues (default OFF)
ISSUE_ACCEPT_RISK_ENABLED=0
# 1=allow LLM-assisted root cause (whitelist stages only)
ISSUE_LLM_CAUSE_ENABLED=0
# batch repair max issues per request
REPAIR_MAX_ISSUES=5

