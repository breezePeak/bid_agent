OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
# API format: openai | anthropic
OPENAI_PROVIDER=openai
OPENAI_TIMEOUT=300
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_INITIAL_DELAY=2
OPENAI_RETRY_MAX_DELAY=30
OPENAI_STREAM=false
OPENAI_VERIFY_SSL=true
BID_AGENT_STAGE_STALL_TIMEOUT=900

# Web authentication. Required; use a long unique password.
BID_AGENT_AUTH_USER=admin
BID_AGENT_AUTH_PASSWORD=replace-with-a-long-random-password
# Set true only when the Web console is served over HTTPS.
BID_AGENT_AUTH_SECURE_COOKIE=false

# 单个投标/公司/模板源文件的最大上传大小（MB，范围 1-2048）。
BID_AGENT_SOURCE_UPLOAD_MAX_MB=512

# V3 按需联网研究。默认禁止 Playwright 驱动个人 DeepSeek 网页账号；请优先接入合规搜索 API。
BID_AGENT_RESEARCH_PROVIDER=doubao_web
# 章节写作阶段：1=缺公开依据时自动联网检索；0=关闭写作联网（企业事实始终不由公开网搜补证）。
BID_AGENT_WRITER_RESEARCH_ENABLED=1
# 仅在已确认服务条款允许的环境中才可显式打开；默认 0。
BID_AGENT_ALLOW_DEEPSEEK_WEB_AUTOMATION=0
# 豆包网页 Provider：使用独立、长期复用的 Chromium 用户目录；查询完成后不关闭浏览器。
BID_AGENT_DOUBAO_PROFILE_DIR=.runtime/doubao-playwright
BID_AGENT_DOUBAO_TIMEOUT_MS=120000
BID_AGENT_DOUBAO_HEADLESS=0
# 登录、短信验证或人工验证最长等待时间；完成后同一次检索自动继续。
BID_AGENT_DOUBAO_LOGIN_WAIT_MS=300000
# 所有网页 Provider 共用的最短发送间隔（秒），范围 30-600；默认 90，防止高频查询。
BID_AGENT_WEB_QUERY_INTERVAL_SECONDS=90
# 页面结构更新时，可覆盖联网搜索控件。
# BID_AGENT_DOUBAO_SEARCH_SELECTOR=button:has-text('联网搜索')
# BID_AGENT_DOUBAO_COMPOSER_SELECTOR=textarea[placeholder*='发消息']
# BID_AGENT_DOUBAO_SEND_SELECTOR=#flow-end-msg-send
# BID_AGENT_DOUBAO_AUTH_PENDING_SELECTOR=[role='dialog']:has-text('验证')
# Optional but recommended on Windows when multiple Python environments exist.
# Use the exact interpreter that runs the backend and has playwright installed.
# BID_AGENT_PYTHON=C:\path\to\python.exe
# 写作 Agent 仅在当前章节需要公开资料时才调用 DeepSeek；不会自动上传附件。
BID_AGENT_DEEPSEEK_PROFILE_DIR=.runtime/deepseek-playwright
BID_AGENT_DEEPSEEK_TIMEOUT_MS=120000
BID_AGENT_DEEPSEEK_HEADLESS=0
# 统一业务校验门禁：任一必需校验失败都会停止当前主流程。
BID_AGENT_VALIDATION_FAILURE_BLOCKS_PIPELINE=1
# 写作失败不回退到旧正文；失败必须在界面中显示。
BID_AGENT_WRITE_FAILURE_FALLBACK=0
# 章节生成完成后直接成为当前有效版本，不再要求 H2 二次确认。
BID_AGENT_CHAPTER_CONFIRMATION_REQUIRED=0
# 单次显式发送给 DeepSeek 的 V3 输入附件限制。
BID_AGENT_DEEPSEEK_MAX_ATTACHMENTS=5
BID_AGENT_DEEPSEEK_MAX_FILE_MB=50
# 登录辅助脚本等待用户登录的最长时间。
BID_AGENT_DEEPSEEK_LOGIN_WAIT_MS=300000
# DeepSeek 页面结构变化时可在此覆盖“联网搜索”按钮的 Playwright selector。
# BID_AGENT_DEEPSEEK_SEARCH_SELECTOR=button:has-text('联网搜索')

# Concurrency (PR-A0). Single source of truth — no hard-coded workers in modules.
# Default chapter worker pool size (clamped to [1, BID_AGENT_WORKERS_MAX])
BID_AGENT_WORKERS_DEFAULT=4
# Hard upper bound for any API/CLI workers argument
BID_AGENT_WORKERS_MAX=10
# Process-wide concurrent LLM HTTP calls (shared across workspaces)
BID_AGENT_LLM_CONCURRENCY=8
# Writing: auto re-batch failed chapters this many times (no fire-desk handoff)
BID_AGENT_WRITE_BATCH_RETRIES=5

# Agent layer (PR-A3+). Supervisor is the default product entry.
# Set false only for emergency rollback to legacy orchestrator.
AGENT_SUPERVISOR_ENABLED=true
AGENT_USE_TOOL_RUNTIME=true
AGENT_MAX_STEPS=12
AGENT_MAX_LLM_CALLS=20
AGENT_MAX_SAME_TOOL_STREAK=2
AGENT_MAX_NO_PROGRESS_STEPS=2
AGENT_MAX_REPAIR_ROUNDS=2
AGENT_MAX_CHAPTERS_PER_INVOKE=5
AGENT_OBSERVATION_MAX_CHARS=2000
AGENT_SNAPSHOT_MAX_CHARS=12000
AGENT_DETERMINISTIC_AUTORUN=true

# 全文审核质量门禁：1=有问题则阻断后续阶段；0=仅记录不阻断
GLOBAL_REVIEW_GATE=1

# quality issues gate: strict=block stops pipeline; soft=record only
QUALITY_GATE_MODE=strict
# 章节审核门禁：1=未通过则阻断后续；0=不阻断
CHAPTER_REVIEW_GATE=1

# 项目概况章节身份校验：1=启用（默认），0=紧急停用
BID_AGENT_PROJECT_IDENTITY_GATE=1

# G4/PR-12 quality-issue enhancements
# 1=allow accept-risk for block issues (default OFF)
ISSUE_ACCEPT_RISK_ENABLED=0
# 1=allow LLM-assisted root cause (whitelist stages only)
ISSUE_LLM_CAUSE_ENABLED=0
# batch repair max issues per request
REPAIR_MAX_ISSUES=5

